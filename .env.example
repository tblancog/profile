# Server-only Resend API key. Create it after the sending domain is verified.
RESEND_API_KEY=

# Server-only inbox that receives contact form messages.
# Do not prefix this with NEXT_PUBLIC_. It must never be available to the browser.
CONTACT_EMAIL=

# Server-only verified sender. Plain address, or a display name plus address:
# Portfolio <sender@your-domain>
CONTACT_FROM=

# Optional shared rate-limit store. Prefer Upstash Redis on Vercel.
# If neither pair is set, the API falls back to an in-memory limiter that
# applies only inside the current server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alternative store used by the Vercel KV / Upstash integration.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional Cloudflare Turnstile. Leave both unset to keep the widget hidden
# and skip server-side verification. The site key is public and is inlined
# at build time, so set it before building. The secret stays on the server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional rate-limit tuning. Defaults are 5 requests per 600 seconds per IP.
# CONTACT_RATE_LIMIT_MAX=5
# CONTACT_RATE_LIMIT_WINDOW_SECONDS=600
